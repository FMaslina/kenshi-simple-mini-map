    <PlatformToolset>v145</PlatformToolset>
    <!-- REQUIRED for KenshiLib: KenshiLib.lib is an import library, so without
         Whole Program Optimization the linker materialises a local import thunk
         in MiniMap.dll for every game function. KenshiLib::GetRealAddress()
         then receives an address inside our own module, which is outside the
         [FUNC_BEGIN, FUNC_END] stub range in KenshiLib.dll, and asserts.
         With /GL the compiler resolves the address of an imported function
         directly to the imported stub in KenshiLib.dll. -->
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
